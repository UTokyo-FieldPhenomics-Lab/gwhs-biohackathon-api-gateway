# Names only — never values. The gateway reads these from the environment, and systemd hands them
# over through ~/.config/biohack-gateway/env, which is 0600 and outside the checkout.
#
# Both have a default that already matches the live environment, so an empty `env` is a working
# gateway and these names matter only when a second environment appears. Settings take effect at
# process start:
#
#   printf 'BIOHACK_INDEX_DIR=/srv/index\n' >> ~/.config/biohack-gateway/env
#   sudo systemctl restart biohack-gateway
#
# The values themselves live in the host's `env`, never in the repository. Where that directory and
# its tree come from: deploy/README.md §1.5.
BIOHACK_INDEX_DIR=
BIOHACK_DATA_BASE_URL=
