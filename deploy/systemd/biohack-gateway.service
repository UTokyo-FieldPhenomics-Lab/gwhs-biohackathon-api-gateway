# The gateway, on the host whose only public entry point is the TLS terminator in front of it.
#
# deploy/setup-gateway.sh rewrites the User= line below to the owner of the checkout and installs
# this file as /etc/systemd/system/biohack-gateway.service. Edit it here rather than there, or the
# next run of that script overwrites the change.
#
# One worker: team lanes, upload receive slots and link admission are process-local. Additional
# workers would multiply those limits and require a different shared-resource design
# (.agents/rules/gateway.md). A per-key request-rate gate is not implemented.
#
# Host state lives in the state directory, not in this file: `env` exists for `EnvironmentFile=` and
# holds one VARIABLE=value per line when a setting reads one; the participant key pool lives beside
# it (.agents/rules/deploy.md). `EnvironmentFile=` gets no `-` prefix, so a missing state file is a
# startup failure rather than
# a service that runs with defaults. deploy/setup-gateway.sh created `env` before installing this
# unit, and rewrites the User=, EnvironmentFile=, and InaccessiblePaths= lines below to the host it
# runs on, so a rebuilt host with a different login needs no edit.

[Unit]
Description=Global Wheat API gateway
After=network-online.target
Wants=network-online.target

[Service]
User=admin
EnvironmentFile=/home/admin/.config/biohack-gateway/env
# The publisher's directory: its environment and the access-key CSV that environment points at. The
# service and the publisher run as the same user, so file modes alone cannot separate them;
# this makes the whole directory genuinely unreadable by the service rather than merely absent from
# its environment. Excluding the directory, not the files, is what keeps a file added there later
# from being readable by accident (.agents/rules/deploy.md).
#
# The path is literal rather than `%h/…`. `%h` is the home of the user running the *manager* — `/root`
# under the system manager — and systemd documents it as unaffected by `User=`, so a `%h` here names a
# directory that never exists, and `systemd` fails the unit at mount namespacing with 226/NAMESPACE
# the first time it is started from this file.
InaccessiblePaths=/home/admin/.config/biohack-gateway/publish
ExecStart=/opt/gwhs-biohackathon-api-gateway/gateway/.venv/bin/uvicorn biohack_gateway.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
