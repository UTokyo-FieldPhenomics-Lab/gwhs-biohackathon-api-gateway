# The API's public surface. TLS terminates here: Caddy obtains and renews the certificate for the
# name below over ACME, so the host stores no certificate and runs no renewal job.
#
# deploy/setup-gateway.sh copies this file to /etc/caddy/Caddyfile. Edit it here rather than there,
# or the next run of that script overwrites the change.
#
# The name is written out instead of coming from the environment: the official Debian caddy.service
# loads no environment file, so a placeholder would need a systemd override for a value that is
# public anyway. setup-gateway.sh checks that this name resolves to the host, and fails at the end
# if the name it served does not match the one here.

api.global-wheat.com {
	# The one limit on a request body, and the only place it is written down.
	#
	# 15 MB is policy, not a buffer size: every model resizes its input to at most 1008 px on a
	# side, so a larger file buys no accuracy and only costs the host — which has 1936 MiB of RAM
	# and holds each upload in memory while it forwards it. 15 MB covers a 48 MP phone JPEG with
	# room to spare and refuses the TIFFs nobody needs to send. Raising it on site is this line plus
	# `systemctl reload caddy`; the message below names the number, so both change together.
	#
	# It sits here rather than in the gateway because this is where the bytes arrive, and because
	# Caddy counts what actually streams past, which is the only check a chunked upload cannot dodge.
	request_body {
		max_size 15MB
	}

	# The row route carries an address, not an image: `{"dataset":"gwfss","row":12}` is about forty
	# bytes, and what it *does* carry beyond that is a query string the application caps at 2 KB.
	# Without this line a 15 MB body reaches the JSON parser before any model is looked up, because
	# parsing happens before the handler: a body of six million integers cost a quarter second of the
	# single worker's event loop and ~150 MB of objects, to be answered `400`. The upload route is a
	# different path and keeps the 15 MB above.
	@row path /models/*/predict
	request_body @row {
		max_size 4KB
	}

	# Every answer carries HSTS, so a browser that has seen this host once will not ask it for plain
	# HTTP again. That matters for the two pages a key is typed into: the first request a reader
	# makes is the one a network between here and them could answer itself, and the redirect on 80
	# happens after the connection that would already be theirs.
	#
	# A day, not a year, and no `preload`. This host exists for one event; a browser that remembers
	# it for a year would refuse plain HTTP to the name long after the event, and preload removal is
	# a submission measured in months. `includeSubDomains` is absent because there are no subdomains.
	header {
		Strict-Transport-Security "max-age=86400"
	}

	# Compress what leaves. The reference page now loads its own 1.6 MB Swagger UI bundle instead of
	# a CDN's precompressed copy, and the JSON answers gain the same way; zstd is what a browser
	# asks for first, gzip is what everything else gets.
	encode zstd gzip

	reverse_proxy 127.0.0.1:8000

	# A refusal in the contract's own shape, because a participant reads one decoder. Caddy would
	# otherwise answer an empty `413`, which is indistinguishable from a proxy failure. One message
	# covers both limits — the upload's 15 MB and the row route's 4 KB — because the reader is a
	# participant holding one client, and a body that names a number the other route enforces would
	# send them looking in the wrong place.
	handle_errors 413 {
		header Content-Type application/json
		# Error routes are their own route group, so the site-level header above does not reach
		# this one; a refusal is still an answer a browser should remember the scheme of.
		header Strict-Transport-Security "max-age=86400"
		respond `{"error":{"code":"payload_too_large","message":"the request body is over this route's limit: an image upload is capped at 15 MB — resize it to about 1008 px, the model runs no larger — and a row prediction carries an address, not an image"}}` 413
	}
}
